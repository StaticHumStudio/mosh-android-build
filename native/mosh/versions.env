# Pinned source set for the shipped mosh-client binaries.
#
# These four tarballs plus build.sh ARE the Corresponding Source for the GPLv3
# binary SlipShell ships. Every version bump here must be mirrored into the
# public build repo (see README.md) alongside the release that used it.
#
# The SHA256s are checked before anything is extracted. They are upstream's
# published values where upstream publishes one, not the hash of whatever a
# download happened to produce. build.sh fails on a mismatch.

# mosh itself. 1.4.0 (2022) is still the only current release, and its tarball
# ships a pre-generated ./configure, so no autotools are needed on the host.
MOSH_VERSION=1.4.0
MOSH_URL=https://github.com/mobile-shell/mosh/releases/download/mosh-1.4.0/mosh-1.4.0.tar.gz
MOSH_SHA256=872e4b134e5df29c8933dff12350785054d2fd2839b5ae6b5587b14db1465ddd

# OpenSSL. The 3.4/3.5 LTS question is load-bearing here in a way it is not for
# an ordinary dependency: this library is linked statically INTO the shipped
# binary, so Android cannot patch it and every install stays on whatever we
# embedded until the next app update.
#
# v1.4.md's spike pinned 3.0.21. That is the newest 3.0.x, but the 3.0 LTS
# branch reaches end of life on 2026-09-07, which lands BEFORE SlipShell's
# first Play release (launch is after v1.5). Shipping a statically embedded
# crypto library that is already out of support at launch is not defensible.
# 3.5.x is the current LTS branch and is supported into 2030.
#
# Verified against upstream's published openssl-3.5.7.tar.gz.sha256.
OPENSSL_VERSION=3.5.7
OPENSSL_URL=https://github.com/openssl/openssl/releases/download/openssl-3.5.7/openssl-3.5.7.tar.gz
OPENSSL_SHA256=a8c0d28a529ca480f9f36cf5792e2cd21984552a3c8e4aa11a24aa31aeac98e8

# protobuf. 3.21.12 is the last release before Abseil became a mandatory
# dependency, which is what keeps this build free of the C++17/Abseil drag that
# G3 flagged. mosh only requires >= 3.6.0, so there is no reason to go newer.
#
# Note the release TAG is v21.12, not v3.21.12. The obvious URL 404s.
PROTOBUF_VERSION=3.21.12
PROTOBUF_URL=https://github.com/protocolbuffers/protobuf/releases/download/v21.12/protobuf-cpp-3.21.12.tar.gz
PROTOBUF_SHA256=4eab9b524aa5913c6fffb20b2a8abf5ef7f95a80bc0701f3a6dbb4c607f73460

# ncurses. The spike used 6.4, which is now two releases stale. mosh uses it for
# terminfo lookup only, and we build it --with-fallbacks so the entries we need
# are compiled into the binary. Android ships no terminfo database at all, so
# without the fallbacks mosh-client exits with "Terminfo database could not be
# found" and needs a bundled tree plus TERMINFO pointed at it.
NCURSES_VERSION=6.6
NCURSES_URL=https://ftp.gnu.org/gnu/ncurses/ncurses-6.6.tar.gz
NCURSES_SHA256=355b4cbbed880b0381a04c46617b7656e362585d52e9cf84a67e2009b749ff11

# Terminal types compiled into libncursesw. TERM in the child environment must
# be one of these, because there is nothing on disk to fall back to.
NCURSES_FALLBACKS=xterm-256color,xterm,xterm-color,vt100,vt220,ansi,linux,screen,screen-256color,dumb

# NDK. Pinned because 16 KB alignment and the bionic link behaviour both depend
# on it. r28+ aligns to 16 KB by default, 27.2 does not, so build.sh passes
# -Wl,-z,max-page-size=16384 explicitly and verify.sh asserts the result.
NDK_VERSION=27.2.12479018

# minSdk. The binaries target the same API level the app does.
ANDROID_API=26

# Shipped ABIs. x86 is deliberately absent (launch-plan G3): no 2026 Play device
# class needs it and no current toolchain targets it.
ABIS="arm64-v8a armeabi-v7a x86_64"
